USER_ID=<YOUR_CAMPUS_ACCOUNT>
# 编码后的密码（非明文）：浏览器登录一次，F12 网络面板找 InterFace.do?method=login
# 的 POST payload，把其中 password 字段的值原样抄过来（passwordEncrypt=true）
PASSWORD_ENC=<YOUR_ENCODED_PASSWORD>
# 认证服务名，以学校网页下拉选项为准，例如"校园网"
SERVICE=<YOUR_SERVICE_NAME>
# 校园认证门户的地址：未认证状态下任意网页被重定向到的那个内网 IP/域名
PORTAL_HOST=<YOUR_CAMPUS_PORTAL_IP>
